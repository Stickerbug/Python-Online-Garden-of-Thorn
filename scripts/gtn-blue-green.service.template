[Unit]
Description=Garden of Thorn blue-green instance
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gtn-next
EnvironmentFile=/etc/gtn/shared.env
EnvironmentFile=/etc/gtn/release.env
EnvironmentFile=/etc/gtn/ai.env
EnvironmentFile=/etc/gtn/gtn-release-next.env
ExecStart=/opt/gtn-next/venv/bin/python /opt/gtn-next/app.py
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
