# GTN blue-green nginx template.
# Merge this idea into the release server block.  Do not copy blindly over the
# whole site file; keep your existing TLS/static/security settings.
#
# Sticky refresh rule:
# - New/lobby traffic uses the "default" active backend below.
# - A browser in an existing match stores cookie gtn_route_port=5000 or 5002.
# - Refreshing during that match is routed back to the old instance.
# - Returning to lobby/rematch clears the cookie and moves to the active backend.

map $cookie_gtn_route_port $gtn_release_backend {
    # Switch only this default line during a blue-green cutover.
    default 127.0.0.1:5000;
    5000 127.0.0.1:5000;
    5002 127.0.0.1:5002;
}

# These shared zones belong in nginx's http context (beside the map above).
# They stop route-sharding floods before Python/SQLite work begins.
limit_req_zone $binary_remote_addr zone=gtn_global_per_ip:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=gtn_connections_per_ip:10m;

server {
    listen 443 ssl http2;
    server_name gtn.stickerbug.top;

    # ssl_certificate ...
    # ssl_certificate_key ...

    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 30s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=gtn_global_per_ip burst=20 nodelay;
    limit_conn gtn_connections_per_ip 30;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location /socket.io/ {
        proxy_pass http://$gtn_release_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite attacker-supplied forwarding headers. The application then
        # trusts exactly one loopback reverse-proxy hop by default.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://$gtn_release_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
